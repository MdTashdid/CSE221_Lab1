public class preques9 {
    public static void main(String[] args) throws IOException {

        FileReader fl = new FileReader("./inp2.txt");
        BufferedReader br = new BufferedReader(fl);

        String line = br.readLine();
        StringTokenizer sr1 = new StringTokenizer(line);

        int N = Integer.parseInt(sr1.nextToken());
        int M = Integer.parseInt(sr1.nextToken());

        int[] num = new int[N];
        int index = 0;

        while (index < N) {
            line = br.readLine();

            if (line == null) {
                throw new IOException("Not enough input numbers");
            }

            StringTokenizer sr2 = new StringTokenizer(line);

            while (sr2.hasMoreTokens() && index < N) {
                num[index] = Integer.parseInt(sr2.nextToken());
                index++;
            }
        }

        br.close();

        // Selection Sort in ascending order
        for (int i = 0; i < N - 1; i++) {
            int min = i;

            for (int j = i + 1; j < N; j++) {
                if (num[j] < num[min]) {
                    min = j;
                }
            }

            if (min != i) {
                int temp = num[i];
                num[i] = num[min];
                num[min] = temp;
            }
        }

        // Calculate minimum and maximum remaining sums
        int keep = N - M;
        long minSum = 0;
        long maxSum = 0;

        for (int i = 0; i < keep; i++) {
            minSum += num[i];
        }

        for (int i = M; i < N; i++) {
            maxSum += num[i];
        }

        long answer = maxSum - minSum;

        // Write output
        FileWriter fw = new FileWriter("./24201428.out");
        PrintWriter pw = new PrintWriter(fw);

        pw.println(answer);

        pw.close();
    }
}


